# AI Control Plane service configuration
# Copy to .env locally or configure these values in your deployment provider.

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Optional provider credentials. The service reports whether these are configured,
# but does not expose their values.
OPENAI_API_KEY=
# Signing secret from the OpenAI Platform webhook configuration. Keep server-side only.
OPENAI_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SIXTYFOUR_API_KEY=
