# AI Control Plane service configuration
# Copy to .env for local service runs. Do not commit real secrets.

NODE_ENV=development
PORT=3000
AI_CONTROL_PLANE_HOST=127.0.0.1

# Optional provider credentials for future provider-backed service operations.
# The current health and verification API does not require these values.
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
